<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <!-- 상단 왼쪽 SAI 뒤로가기 -->
    <TextView
        android:id="@+id/tvBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="〈  SAI"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 상단 중앙 모드명 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NAPPING · 수면 모드"
        android:textColor="#7A8FAA"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="@id/tvBack"
        app:layout_constraintBottom_toBottomOf="@id/tvBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 상단 오른쪽: 음소거 버튼 -->
    <TextView
        android:id="@+id/btnMute"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:text="🔇"
        android:textSize="18sp"
        android:gravity="center"
        android:contentDescription="음소거"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnClose"/>

    <!-- 상단 오른쪽: X 닫기 버튼 -->
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:text="✕"
        android:textColor="#7A8FAA"
        android:textSize="18sp"
        android:gravity="center"
        android:contentDescription="닫기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 큰 멘트 텍스트 -->
    <TextView
        android:id="@+id/tvMainMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잠깐의 휴식으로 에너지를 채워요"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 서브 텍스트 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20분 뒤 부드럽게 깨울게요."
        android:textColor="#7A8FAA"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMainMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 그래픽 영역 (빈 공간) -->
    <FrameLayout
        android:id="@+id/layoutGraphic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ASMR 선택 버튼 -->
    <Button
        android:id="@+id/btnAsmrSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 ASMR 1"
        android:textColor="#7A8FAA"
        android:textSize="11sp"
        android:background="@drawable/bg_dropdown"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="@id/layoutGraphic"
        app:layout_constraintEnd_toEndOf="@id/layoutGraphic"/>

    <!-- 하단 박스 영역 -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 진행 시간 라벨 + 단계 텍스트 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="진행 시간"
                android:textColor="#3A4A6A"
                android:textSize="10sp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tvPhaseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수면 진입"
                android:textColor="#3A4A6A"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- 타이머 + 퍼센트 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / 20:00"
                android:textColor="#3A4A6A"
                android:textSize="13sp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#4A9EFF"
                android:textSize="13sp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>

        <!-- 프로그레스 바 -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>