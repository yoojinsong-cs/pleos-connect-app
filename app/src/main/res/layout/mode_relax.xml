<?xml version="1.0" encoding="utf-8"?>
<!-- [릴렉스 담당] mode_relax.xml (v11)
     싱잉볼 → 오늘의 릴렉스(6개 모드) → 3초 카운트다운 → 1~4단계 → 완료 → 세션 완료 → 이번 주 기록
     디자인 포맷: 배경 #1B1C20 · 흰색 #F6F6F7 · 강조 #DCC6AB · 버튼 배경 #27292E · 라운드 20
     제목은 위쪽 바에서 28dp 아래부터 / 진행 바는 맨 아래에서 64dp 위
     글씨: 부제목 22 · 대제목 48 · 소제목 24 · 중간 버튼 28/22 · 하단 버튼 28 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C20"
    android:orientation="vertical"
    android:paddingHorizontal="64dp"
    android:paddingTop="140dp"
    android:paddingBottom="64dp">

    <!-- 위쪽 글씨 (가운데) -->
    <TextView
        android:id="@+id/relaxLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:text="SINGING BOWL"
        android:textColor="#DCC6AB"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/relaxTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="오늘의 싱잉볼"
        android:textColor="#F6F6F7"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/relaxSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="역할과 역할 사이를 조율합니다."
        android:textColor="#B3F6F6F7"
        android:textSize="24sp" />

    <!-- 1~4단계 칸 (릴렉스 5분 동안만 보여요) -->
    <LinearLayout
        android:id="@+id/relaxSteps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- 가운데 자리 (화면마다 하나만 보여요) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="16dp">

        <!-- 싱잉볼 (점 그릇 · 채 · 물결) -->
        <com.example.hyundai_first_project.SingingBowlView
            android:id="@+id/relaxBowl"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 모드 그림 (비·캠핑·우주·바다·숲·기본) -->
        <com.example.hyundai_first_project.ParticleView
            android:id="@+id/relaxParticles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 싱잉볼 건너뛰기 (싱잉볼 화면에서만 보여요) -->
        <TextView
            android:id="@+id/relaxSkip"
            android:layout_width="300dp"
            android:layout_height="88dp"
            android:layout_gravity="bottom|end"
            android:gravity="center"
            android:text="싱잉볼 건너뛰기  ›"
            android:textColor="#F6F6F7"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 환경 맞추는 중: 3초 카운트다운 -->
        <LinearLayout
            android:id="@+id/relaxLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 등받이가 지금 각도 → 117°로 눕혀지는 그림 -->
            <com.example.hyundai_first_project.SeatAngleView
                android:id="@+id/relaxSeatAngle"
                android:layout_width="680dp"
                android:layout_height="300dp" />

            <TextView
                android:id="@+id/relaxCountdown"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="3"
                android:textColor="#F6F6F7"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/relaxLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="따뜻한 색 조명 · 명상 음악"
                android:textColor="#DCC6AB"
                android:textSize="24sp" />


        </LinearLayout>

        <!-- 오늘의 릴렉스: 모드 6개 (카드는 코드에서 만들어요) -->
        <LinearLayout
            android:id="@+id/relaxChoose"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/relaxModeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/relaxNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="모드를 누르면 조명과 음악이 모드에 맞게 바뀌어요."
                android:textColor="#80F6F6F7"
                android:textSize="22sp" />


        </LinearLayout>

        <!-- 이번 주 리추얼 기록 (월~일 칸은 코드에서 만들어요) -->
        <LinearLayout
            android:id="@+id/relaxRecord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/relaxWeekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="마이현대 앱에서 자세히 확인하실 수 있어요."
                android:textColor="#80F6F6F7"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/relaxRecordHome"
                android:layout_width="520dp"
                android:layout_height="96dp"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="홈으로 돌아가기"
                android:textColor="#1B1C20"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 세션 완료 (원래대로 복원) -->
        <LinearLayout
            android:id="@+id/relaxDone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.example.hyundai_first_project.ParticleView
                android:id="@+id/relaxSphere"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/relaxDoneCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/relaxDoneIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#DCC6AB"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="차량 환경을 이전 설정으로 복원했어요"
                            android:textColor="#F6F6F7"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="지원되는 항목에 한해 복원을 적용했어요."
                            android:textColor="#99F6F6F7"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/relaxHome"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="이번 주 기록 보기  ›"
                    android:textColor="#1B1C20"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 진행 시간 (음악 플레이어처럼) -->
    <LinearLayout
        android:id="@+id/relaxProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/relaxNowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="지금 · 싱잉볼"
                android:textColor="#B3F6F6F7"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/relaxPhaseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다음 스텝 : 환경 확인"
                android:textColor="#DCC6AB"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/relaxElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="00:00"
                android:textColor="#F6F6F7"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/relaxTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:text="/ 01:00"
                android:textColor="#80F6F6F7"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/relaxPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="0%"
                android:textColor="#A9A2E8"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 진행바 (손으로 못 움직여요) -->
        <SeekBar
            android:id="@+id/relaxSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#33F6F6F7"
            android:progressTint="#A9A2E8"
            android:thumbTint="#A9A2E8" />
    </LinearLayout>
</LinearLayout>
