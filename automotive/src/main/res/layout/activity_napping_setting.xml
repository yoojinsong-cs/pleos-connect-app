<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C20"
    android:orientation="vertical">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp">

        <ImageView
            android:id="@+id/tvBack"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_back"
            android:contentDescription="뒤로가기" />

        <ImageView
            android:layout_width="160dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="SAI"
            android:src="@drawable/sai_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_close"
            android:contentDescription="닫기" />
    </LinearLayout>

    <!-- 상단바 아래 고정 헤더 텍스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="NAPPING · PREPARE"
            android:textColor="#DCC6AB"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="낮잠 시작 전 환경을 확인해 주세요"
            android:textColor="#F6F6F7"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="살려주세요진짜로"
            android:textColor="#99F6F6F7"
            android:textSize="24sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- 카드 영역 중앙 정렬 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="64dp">

        <!-- 카드 3개 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 조명 -->
            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="280dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="30dp">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:src="@drawable/ic_light"
                    android:padding="24dp"
                    android:contentDescription="조명" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="조명"
                    android:textColor="#F6F6F7"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="어둡게"
                    android:textColor="#99F6F6F7"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- 바람 -->
            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="280dp"
                android:layout_marginStart="36dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="30dp">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:src="@drawable/ic_fan"
                    android:padding="24dp"
                    android:contentDescription="바람" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="바람"
                    android:textColor="#F6F6F7"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="약하게"
                    android:textColor="#99F6F6F7"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- 등받이 -->
            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="280dp"
                android:layout_marginStart="36dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="30dp">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:src="@drawable/ic_seat"
                    android:padding="24dp"
                    android:contentDescription="등받이" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="등받이"
                    android:textColor="#F6F6F7"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="120°"
                    android:textColor="#99F6F6F7"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="차량이 지원하는 설정만 적용됩니다."
            android:textColor="#80F6F6F7"
            android:textSize="24sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- 버튼: 하단 64dp 고정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:paddingBottom="64dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_start"
            android:text="시작"
            android:textColor="#1B1C20"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</LinearLayout>