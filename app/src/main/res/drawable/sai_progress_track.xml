<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="3dp" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/sai_test_line" />
            <corners android:radius="1.5dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress" android:height="3dp" android:gravity="center_vertical">
        <clip android:clipOrientation="horizontal" android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="@color/sai_test_accent" />
                <corners android:radius="1.5dp" />
            </shape>
        </clip>
    </item>
</layer-list>
