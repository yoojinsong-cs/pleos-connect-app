<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <application android:allowBackup="true" android:icon="@drawable/sai_brand_logo" android:roundIcon="@drawable/sai_brand_logo" android:label="SAI" android:supportsRtl="true" android:theme="@style/SaiDemoTheme">
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".GleoActionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="STOP_NAP_ROUTINE" />
                <action android:name="SET_NEXT_SCHEDULE" />
                <action android:name="GET_NEXT_SCHEDULE" />
                <action android:name="CONTROL_AWAKEN_MODE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
