<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B1C20"
    android:gravity="center">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:layout_gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="〈"
                android:textColor="#F6F6F7"
                android:textSize="48sp"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="174dp"
                android:layout_height="42dp"
                android:src="@drawable/sai_logo"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="✕"
            android:textColor="#DCC6AB"
            android:textSize="48sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- 중앙 콘텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="120dp"
        android:paddingEnd="120dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RELAX · PREPARE"
            android:textColor="#DCC6AB"
            android:textSize="32sp"
            android:letterSpacing="0.15"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="직접 조절하기"
            android:textColor="#F6F6F7"
            android:textSize="80sp"
            android:fontFamily="sans-serif-light"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="원하는 대로 설정을 조절해요."
            android:textColor="#DCC6AB"
            android:textSize="40sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <!-- 카드 3개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="550dp"
            android:orientation="horizontal"
            android:layout_marginTop="60dp">

            <!-- 조명 카드 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_rounded"
                android:padding="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_light"
                        android:layout_marginEnd="16dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="앰비언트 조명"
                        android:textColor="#F6F6F7"
                        android:textSize="48sp"/>

                    <TextView
                        android:id="@+id/tvLightValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="소등"
                        android:textColor="#DCC6AB"
                        android:textSize="48sp"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:max="3"
                    android:progress="0"
                    android:progressTint="#DCC6AB"
                    android:thumbTint="#DCC6AB"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="소등"
                        android:textColor="#7A8FAA"
                        android:textSize="36sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대"
                        android:textColor="#7A8FAA"
                        android:textSize="36sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 공조 풍량 카드 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_rounded"
                android:padding="32dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_fan"
                        android:layout_marginEnd="16dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="공조 풍량"
                        android:textColor="#F6F6F7"
                        android:textSize="48sp"/>

                    <TextView
                        android:id="@+id/tvFanValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="낮음"
                        android:textColor="#DCC6AB"
                        android:textSize="48sp"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekFan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:max="3"
                    android:progress="1"
                    android:progressTint="#DCC6AB"
                    android:thumbTint="#DCC6AB"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="끔"
                        android:textColor="#7A8FAA"
                        android:textSize="36sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="최대"
                        android:textColor="#7A8FAA"
                        android:textSize="36sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 시트 각도 카드 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_rounded"
                android:padding="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_seat"
                        android:layout_marginEnd="16dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="시트 각도"
                        android:textColor="#F6F6F7"
                        android:textSize="48sp"/>

                    <TextView
                        android:id="@+id/tvSeatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="130°"
                        android:textColor="#DCC6AB"
                        android:textSize="48sp"/>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekSeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:max="60"
                    android:progress="30"
                    android:progressTint="#DCC6AB"
                    android:thumbTint="#DCC6AB"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="100°"
                        android:textColor="#7A8FAA"
                        android:textSize="36sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="160°"
                        android:textColor="#7A8FAA"
                        android:textSize="36sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- 버튼 2개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="60dp"
            android:layout_marginStart="280dp"
            android:layout_marginEnd="280dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="2"
                android:text="이 설정으로 시작하기"
                android:textColor="#1B1C20"
                android:textSize="36sp"
                android:backgroundTint="#F6F6F7"/>

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="돌아가기"
                android:textColor="#F6F6F7"
                android:textSize="36sp"
                android:backgroundTint="#27292E"
                android:background="@drawable/bg_button_secondary"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>