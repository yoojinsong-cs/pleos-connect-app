<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B1C20">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/tvBack"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_back"
                android:contentDescription="뒤로가기"/>

            <ImageView
                android:layout_width="174dp"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/sai_logo"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_close"
            android:contentDescription="닫기"/>

    </LinearLayout>

    <!-- 상단바 아래 고정 헤더 텍스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAPPING · TIME"
            android:textColor="#DCC6AB"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="낮잠 시간을 선택해 주세요"
            android:textColor="#F6F6F7"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="##################################################################################################"
            android:textColor="#99F6F6F7"
            android:textSize="24sp"
            android:fontFamily="sans-serif"
            android:gravity="center"/>

    </LinearLayout>

    <!-- 카드 영역 중앙 정렬 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="200dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/card10"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_time_card_normal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:textColor="#F6F6F7"
                        android:textSize="60sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="분"
                        android:textColor="#DCC6AB"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card15"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_time_card_normal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15"
                        android:textColor="#F6F6F7"
                        android:textSize="60sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="분"
                        android:textColor="#DCC6AB"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card20"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_time_card_normal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textColor="#F6F6F7"
                        android:textSize="60sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="분"
                        android:textColor="#DCC6AB"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card30"
                    android:layout_width="0dp"
                    android:layout_height="220dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_time_card_normal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textColor="#F6F6F7"
                        android:textSize="60sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="분"
                        android:textColor="#DCC6AB"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 버튼: 하단 64dp 고정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="64dp"
        android:paddingBottom="64dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_button_start"
            android:text="시작"
            android:textColor="#1B1C20"
            android:textSize="28sp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>