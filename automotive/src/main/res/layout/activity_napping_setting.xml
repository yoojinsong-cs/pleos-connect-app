<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C20"
    android:orientation="vertical">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F6F6F7"
            android:textSize="56sp"
            android:fontFamily="sans-serif" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="SAI"
            android:src="@drawable/sai_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#F6F6F7"
            android:textSize="40sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- 상단바 26dp 아래 고정 헤더 텍스트 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="64dp"
        android:paddingTop="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="NAPPING · PREPARE"
            android:textColor="#DCC6AB"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="낮잠 시작 전 환경을 확인해 주세요"
            android:textColor="#F6F6F7"
            android:textSize="48sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="#################################################################"
            android:textColor="#99F6F6F7"
            android:textSize="24sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- 카드 영역 중앙 정렬 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="64dp">

        <!-- 카드 3개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 조명 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:gravity="center"
                    android:text="☼"
                    android:textColor="#DCC6AB"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="조명"
                    android:textColor="#F6F6F7"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="어둡게"
                    android:textColor="#99F6F6F7"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- 바람 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:gravity="center"
                    android:text="≋"
                    android:textColor="#DCC6AB"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="바람"
                    android:textColor="#F6F6F7"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="약하게"
                    android:textColor="#99F6F6F7"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- 등받이 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:gravity="center"
                    android:text="⌒"
                    android:textColor="#DCC6AB"
                    android:textSize="34sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="등받이"
                    android:textColor="#F6F6F7"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="120°"
                    android:textColor="#99F6F6F7"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="차량이 지원하는 설정만 적용됩니다."
            android:textColor="#80F6F6F7"
            android:textSize="18sp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- 버튼 2개: 하단 64dp 고정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="64dp"
        android:paddingBottom="64dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_weight="1"
            android:backgroundTint="#E1E1E1"
            android:text="시작"
            android:textColor="#1B1C20"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

    </LinearLayout>

</LinearLayout>