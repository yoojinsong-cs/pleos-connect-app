<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/sai_test_bg" android:paddingLeft="28dp" android:paddingRight="28dp" android:paddingTop="12dp" android:paddingBottom="64dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/sai_back" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginRight="12dp" android:background="@drawable/sai_icon_button" android:src="@drawable/sai_ic_back" android:padding="22dp" android:contentDescription="뒤로 가기" android:tint="@null" />
        <ImageView android:layout_width="144dp" android:layout_height="32dp" android:src="@drawable/sai_wordmark" android:scaleType="fitCenter" android:contentDescription="SAI" />
        <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
        <ImageButton android:id="@+id/sai_mute" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginLeft="8dp" android:background="@drawable/sai_icon_button" android:src="@drawable/sai_ic_sound_on" android:padding="22dp" android:contentDescription="앱 음악과 음성 안내 음소거" android:tint="@null" />
        <ImageButton android:id="@+id/sai_force" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginLeft="4dp" android:background="@drawable/sai_icon_button" android:src="@drawable/sai_ic_close" android:padding="22dp" android:contentDescription="각성 모드 종료" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_marginTop="0dp" android:id="@+id/sai_scroll" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="26dp" android:paddingBottom="0dp" android:id="@+id/sai_content">
                <TextView android:id="@+id/sai_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="AWAKEN · BEGIN" android:textSize="@dimen/sai_type_stage" android:letterSpacing="0.08" android:textColor="@color/sai_test_accent" android:includeFontPadding="false" />
                <TextView android:id="@+id/sai_title" style="@style/SaiTestText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="각성을 시작해요" android:textSize="@dimen/sai_type_title" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/sai_guidance" style="@style/SaiTestText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="호흡을 가다듬어 각성을 준비해요." android:textSize="@dimen/sai_type_guidance" android:lineSpacingExtra="6dp" android:textColor="@color/sai_test_muted" android:includeFontPadding="false" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/sai_sound_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="음성 안내 켜짐" android:textSize="@dimen/sai_type_status" android:textColor="@color/sai_test_muted" android:includeFontPadding="false" />
                <TextView android:id="@+id/sai_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textSize="@dimen/sai_type_status" android:textColor="@color/sai_test_muted" android:includeFontPadding="false" />
                <Space android:id="@+id/sai_visual_space_top" android:layout_width="1dp" android:layout_height="0dp" />
                <com.example.hyundaiappproject.SaiAwakenVisualView android:id="@+id/sai_visual" android:layout_width="match_parent" android:layout_height="@dimen/sai_visual_min_height" android:layout_marginTop="0dp" android:layout_marginBottom="0dp" />
                <Space android:id="@+id/sai_visual_space_bottom" android:layout_width="1dp" android:layout_height="0dp" />
                <LinearLayout android:id="@+id/sai_completion_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp" android:visibility="gone">
                    <TextView android:id="@+id/sai_completion_schedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="다음 일정은 오후 2시, 회의입니다." android:textSize="@dimen/sai_type_schedule" android:gravity="center" android:textColor="@color/sai_test_accent" android:includeFontPadding="false" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="20dp" android:orientation="vertical" android:gravity="center_horizontal" android:background="@drawable/sai_restore_card">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_marginRight="12dp" android:src="@drawable/sai_ic_complete" android:importantForAccessibility="no" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="차량 환경을 이전 설정으로 복원했어요." android:textColor="@color/sai_test_white" android:textSize="@dimen/sai_type_note" android:gravity="center" android:includeFontPadding="false" />
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="지원되는 항목에 한해 복원을 적용했어요." android:textColor="@color/sai_test_muted" android:textSize="@dimen/sai_type_status" android:gravity="center" android:includeFontPadding="false" />
                    </LinearLayout>
                    <Button android:id="@+id/sai_home" android:layout_width="340dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" android:background="@drawable/sai_home_button" android:backgroundTint="@color/sai_test_button_bg" android:text="홈으로 돌아가기" android:textColor="@color/sai_test_white" android:textSize="@dimen/sai_type_button" android:textAllCaps="false" android:stateListAnimator="@null" android:elevation="0dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/sai_safety_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="20dp" android:padding="28dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/sai_test_card" android:visibility="gone">
            <TextView android:id="@+id/sai_safety_icon" android:layout_width="64dp" android:layout_height="48dp" android:gravity="center" android:text="!" android:textSize="28sp" android:textColor="@color/sai_test_accent" android:layout_marginTop="0dp" android:includeFontPadding="false" android:layout_gravity="center_horizontal" android:background="@drawable/sai_safety_badge" />
            <TextView android:id="@+id/sai_safety_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="차량 상태가 바뀌어 중단했어요" android:textSize="26sp" android:textColor="@color/sai_test_white" android:layout_marginTop="20dp" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="26sp" />
            <TextView android:id="@+id/sai_safety_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="안전을 위해 모드를 종료했어요.\n주차 상태를 확인한 뒤 다시 시작해 주세요." android:textSize="17sp" android:textColor="@color/sai_test_muted" android:layout_marginTop="12dp" android:includeFontPadding="false" android:lineSpacingExtra="8dp" />
            <Button android:id="@+id/sai_safety_close" style="@style/SaiTestButton" android:layout_width="260dp" android:layout_height="56dp" android:layout_marginTop="26dp" android:text="닫기" android:textSize="20sp" android:textColor="#1B1C20" android:backgroundTint="#E5E6EB" android:layout_gravity="center_horizontal" android:gravity="center" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/sai_progress_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/sai_test_card" android:layout_marginTop="16dp" android:layout_marginBottom="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="경과 시간" android:textSize="@dimen/sai_type_label" android:textColor="@color/sai_test_muted" android:includeFontPadding="false" />
            <TextView android:id="@+id/sai_progress_stage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="시작 · 감각 깨우기" android:textSize="@dimen/sai_type_label" android:textColor="@color/sai_test_accent" android:includeFontPadding="false" />
            <Button android:id="@+id/sai_skip_bowl" android:layout_width="112dp" android:layout_height="44dp" android:layout_marginLeft="16dp" android:text="건너뛰기" android:contentDescription="싱잉볼 건너뛰고 5분 릴렉스 시작" android:textSize="16sp" android:textColor="#BDE4CA" android:fontFamily="sans-serif-medium" android:textAllCaps="false" android:singleLine="true" android:minWidth="0dp" android:minHeight="0dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:background="@drawable/sai_skip_bowl_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:visibility="gone" android:gravity="center" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="5dp">
            <TextView android:id="@+id/sai_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textSize="@dimen/sai_type_elapsed" android:textColor="@color/sai_test_white" android:includeFontPadding="false" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:id="@+id/sai_total" android:text="/ 03:00" android:textSize="@dimen/sai_type_label" android:textColor="@color/sai_test_muted" android:includeFontPadding="false" />
            <TextView android:id="@+id/sai_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textSize="@dimen/sai_type_percent" android:textColor="@color/sai_test_accent" android:includeFontPadding="false" />
        </LinearLayout>
        <com.example.hyundaiappproject.SaiDotProgressBar android:id="@+id/sai_progress" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="18dp" />
    </LinearLayout>
</LinearLayout>