<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C20"
    android:orientation="vertical">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F6F6F7"
            android:textSize="56sp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="SAI"
            android:src="@drawable/sai_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#F6F6F7"
            android:textSize="40sp" />
    </LinearLayout>

    <!-- 중앙 콘텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="NAPPING · PREPARE"
            android:textColor="#DCC6AB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="냅핑 시작 전 환경을 확인해 주세요"
            android:textColor="#F6F6F7"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="설정을 확인하거나 원하는 대로 조절할 수 있어요."
            android:textColor="#99F6F6F7"
            android:textSize="24sp" />

        <!-- 카드 3개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal">

            <!-- 조명 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:gravity="center"
                    android:text="☼"
                    android:textColor="#DCC6AB"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="조명"
                    android:textColor="#F6F6F7"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="어둡게"
                    android:textColor="#99F6F6F7"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 바람 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:gravity="center"
                    android:text="≋"
                    android:textColor="#DCC6AB"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="바람"
                    android:textColor="#F6F6F7"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="약하게"
                    android:textColor="#99F6F6F7"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 등받이 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_icon_rounded"
                    android:gravity="center"
                    android:text="⌒"
                    android:textColor="#DCC6AB"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="등받이"
                    android:textColor="#F6F6F7"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="115–120°"
                    android:textColor="#99F6F6F7"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="차량이 지원하는 설정만 적용됩니다."
            android:textColor="#80F6F6F7"
            android:textSize="18sp" />

        <!-- 버튼 2개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:backgroundTint="#E1E1E1"
                android:text="이대로 시작"
                android:textColor="#1B1C20"
                android:textSize="26sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCustom"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:backgroundTint="#27292E"
                android:text="설정 변경"
                android:textColor="#F6F6F7"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>