<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B1C20">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="〈"
                android:textColor="#F6F6F7"
                android:textSize="48sp"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="174dp"
                android:layout_height="42dp"
                android:src="@drawable/sai_logo"/>

        </LinearLayout>

        <!-- 스피커 아이콘 버튼 -->
        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_volume_on"
            android:background="@android:color/transparent"
            android:scaleType="center"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="✕"
            android:textColor="#DCC6AB"
            android:textSize="48sp"
            android:gravity="center"/>

    </LinearLayout>

    <!-- 중앙 콘텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="120dp"
        android:paddingEnd="120dp">

        <TextView
            android:id="@+id/tvPhaseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAPPING · WIND DOWN"
            android:textColor="#DCC6AB"
            android:textSize="32sp"
            android:letterSpacing="0.15"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="눈을 감고 편안하게 쉬세요"
            android:textColor="#F6F6F7"
            android:textSize="80sp"
            android:fontFamily="sans-serif-light"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="안내 음성은 잠시 후 종료돼요."
            android:textColor="#DCC6AB"
            android:textSize="40sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <!-- ASMR 드롭다운: subtitle과 파티클 사이 -->
        <Button
            android:id="@+id/btnAsmrSelect"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="♪  ASMR 1"
            android:textColor="#DCC6AB"
            android:textSize="26sp"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_dropdown"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"/>

        <com.example.myapplication.ParticleView
            android:id="@+id/particleView"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_gravity="center"/>

    </LinearLayout>

    <!-- 하단 진행 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_rounded"
        android:padding="40dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="진행 시간"
                android:textColor="#DCC6AB"
                android:textSize="28sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#F6F6F7"
                    android:textSize="52sp"
                    android:fontFamily="sans-serif-light"/>

                <!-- id 추가: 선택한 시간에 맞게 동적으로 바뀜 -->
                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / 20:00"
                    android:textColor="#DCC6AB"
                    android:textSize="36sp"
                    android:layout_marginStart="8dp"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#DCC6AB"
                android:progressBackgroundTint="#27292E"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="40dp">

            <TextView
                android:id="@+id/tvPhaseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수면 진입"
                android:textColor="#DCC6AB"
                android:textSize="28sp"
                android:layout_gravity="end"/>

            <TextView
                android:id="@+id/tvPhasePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#F6F6F7"
                android:textSize="52sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>