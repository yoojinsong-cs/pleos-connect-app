<?xml version="1.0" encoding="utf-8"?>
<!-- [릴렉스 담당] mode_relax.xml : 싱잉볼 → 환경 확인 → 호흡 → 스트레칭 → 완료 → 세션 완료
     위쪽 ‹ SΛI × 는 activity_main.xml 에 있어서 여기엔 없어요.
     색: 배경 #1B1C20 · 흰색 #F6F6F7 · 강조 #DCC6AB · 보라 #A9A2E8 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C20"
    android:orientation="vertical"
    android:paddingHorizontal="64dp"
    android:paddingTop="120dp"
    android:paddingBottom="36dp">

    <!-- 위쪽 글씨 (가운데 정렬) -->
    <TextView
        android:id="@+id/relaxLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:text="SINGING BOWL · BEGIN"
        android:textColor="#DCC6AB"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/relaxTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="싱잉볼 소리에 귀 기울여 보세요"
        android:textColor="#F6F6F7"
        android:textSize="54sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/relaxSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="첫 번째 울림이 시작됩니다."
        android:textColor="#B3F6F6F7"
        android:textSize="26sp" />

    <!-- 1~4단계 칸 (릴렉스 5분 동안만 보여요. 칸은 코드에서 만들어요) -->
    <LinearLayout
        android:id="@+id/relaxSteps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- 가운데 그림 자리 (화면마다 하나만 보여요) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="20dp">

        <!-- 싱잉볼 -->
        <com.example.hyundai_first_project.SingingBowlView
            android:id="@+id/relaxBowl"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_gravity="center" />

        <!-- 호흡·스트레칭 소용돌이 -->
        <com.example.hyundai_first_project.ParticleView
            android:id="@+id/relaxParticles"
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 환경 맞추는 중: 3초 카운트다운 -->
        <LinearLayout
            android:id="@+id/relaxLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp">

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:indeterminateTint="#DCC6AB" />

                <TextView
                    android:id="@+id/relaxCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#F6F6F7"
                    android:textSize="96sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/relaxLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="따뜻한 색 조명 · 약한 바람 · 등받이 118°"
                android:textColor="#DCC6AB"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- 환경 확인 -->
        <LinearLayout
            android:id="@+id/relaxPrepare"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/relaxCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/relaxLightCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="40dp">

                    <TextView
                        android:id="@+id/relaxLightIcon"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:gravity="center"
                        android:text="☼"
                        android:textColor="#DCC6AB"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="조명"
                        android:textColor="#F6F6F7"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/relaxLightSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="따뜻한 색"
                        android:textColor="#99F6F6F7"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/relaxAirCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="40dp">

                    <TextView
                        android:id="@+id/relaxAirIcon"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:gravity="center"
                        android:text="≋"
                        android:textColor="#DCC6AB"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="바람"
                        android:textColor="#F6F6F7"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/relaxAirSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="약하게"
                        android:textColor="#99F6F6F7"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/relaxSeatCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="40dp">

                    <TextView
                        android:id="@+id/relaxSeatIcon"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:gravity="center"
                        android:text="⌒"
                        android:textColor="#DCC6AB"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="등받이"
                        android:textColor="#F6F6F7"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/relaxSeatSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="115–120°"
                        android:textColor="#99F6F6F7"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 설정 변경을 누르면 나오는 칸 (조명·바람·등받이·온도·소리) -->
            <LinearLayout
                android:id="@+id/relaxSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="10dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="조명"
                        android:textColor="#F6F6F7"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/relaxLightChoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="바람"
                        android:textColor="#F6F6F7"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/relaxAirChoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="등받이"
                        android:textColor="#F6F6F7"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/relaxSeatLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="118°"
                        android:textColor="#DCC6AB"
                        android:textSize="22sp" />

                    <SeekBar
                        android:id="@+id/relaxSeatSeek"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:progressTint="#DCC6AB"
                        android:thumbTint="#DCC6AB" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="온도"
                        android:textColor="#F6F6F7"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/relaxTempLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="24.0°C"
                        android:textColor="#DCC6AB"
                        android:textSize="22sp" />

                    <SeekBar
                        android:id="@+id/relaxTempSeek"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:progressTint="#DCC6AB"
                        android:thumbTint="#DCC6AB" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="소리"
                        android:textColor="#F6F6F7"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/relaxVolumeLabel"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="70%"
                        android:textColor="#DCC6AB"
                        android:textSize="22sp" />

                    <SeekBar
                        android:id="@+id/relaxVolumeSeek"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:progressTint="#DCC6AB"
                        android:thumbTint="#DCC6AB" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/relaxNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="차량이 지원하는 설정만 적용됩니다."
                android:textColor="#80F6F6F7"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/relaxButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/relaxStart"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="이대로 시작"
                    android:textColor="#1B1C20"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/relaxChange"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="설정 변경"
                    android:textColor="#F6F6F7"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 이번 주 리추얼 기록 (월~일 칸은 코드에서 만들어요) -->
        <LinearLayout
            android:id="@+id/relaxRecord"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/relaxWeekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="마이현대 앱에서 자세히 확인하실 수 있어요."
                android:textColor="#80F6F6F7"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/relaxRecordHome"
                android:layout_width="520dp"
                android:layout_height="96dp"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="홈으로 돌아가기"
                android:textColor="#1B1C20"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 세션 완료 (원래대로 복원) -->
        <LinearLayout
            android:id="@+id/relaxDone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.example.hyundai_first_project.ParticleView
                android:id="@+id/relaxSphere"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/relaxDoneCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/relaxDoneIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#DCC6AB"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="차량 환경을 이전 설정으로 복원했어요"
                            android:textColor="#F6F6F7"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="지원되는 항목에 한해 복원을 적용했어요."
                            android:textColor="#99F6F6F7"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/relaxHome"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="이번 주 기록 보기  ›"
                    android:textColor="#1B1C20"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 진행 시간 (음악 플레이어처럼) -->
    <LinearLayout
        android:id="@+id/relaxProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/relaxNowLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="지금 · 싱잉볼"
                android:textColor="#B3F6F6F7"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/relaxPhaseLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다음 스텝 : 환경 확인"
                android:textColor="#DCC6AB"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/relaxElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="00:00"
                android:textColor="#F6F6F7"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/relaxTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:text="/ 01:00"
                android:textColor="#80F6F6F7"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/relaxPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="0%"
                android:textColor="#A9A2E8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 진행바 (손으로 못 움직여요) -->
        <SeekBar
            android:id="@+id/relaxSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressBackgroundTint="#33F6F6F7"
            android:progressTint="#A9A2E8"
            android:thumbTint="#A9A2E8" />
    </LinearLayout>
</LinearLayout>
