<?xml version="1.0" encoding="utf-8"?>
<!-- [공용] activity_main.xml : 첫 화면 · 준비 완료 · 모드 선택 · 모드 화면 자리 · 안전 중단 + 위쪽 ‹ SAI ×
     색: 배경 #1B1C20 · 흰색 #F6F6F7 · 강조 #DCC6AB · 릴렉스 보라 #A9A2E8
     (#99F6F6F7 처럼 앞에 두 글자가 붙은 건 같은 색을 투명하게 한 거예요) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C20">

  <!-- 1. 첫 화면 (주행 중) -->
  <LinearLayout
      android:id="@+id/homeView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.5"
        android:text="— SΛI —"
        android:textColor="#DCC6AB"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="마인드풀 드라이브"
        android:textColor="#F6F6F7"
        android:textSize="52sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="차량 연결 중..."
        android:textColor="#99F6F6F7"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/adviceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="기어를 P에 두면 SAI가 시작돼요."
        android:textColor="#DCC6AB"
        android:textSize="30sp" />
  </LinearLayout>

  <!-- 2. 준비 완료 (안전 조건 확인) -->
  <LinearLayout
      android:id="@+id/readyView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingHorizontal="56dp"
      android:paddingTop="120dp"
      android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="READY"
        android:textColor="#DCC6AB"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="SAI를 시작할 준비가 됐어요"
        android:textColor="#F6F6F7"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="차량 상태를 확인했어요. 원하는 모드를 선택해 주세요."
        android:textColor="#99F6F6F7"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal">

      <LinearLayout
          android:id="@+id/readyPark"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="48dp">

        <TextView
            android:id="@+id/readyParkIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="P"
            android:textColor="#DCC6AB"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="주차 상태"
            android:textColor="#F6F6F7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/readyParkSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="P단 확인"
            android:textColor="#99F6F6F7"
            android:textSize="21sp" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/readyDriver"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="20dp"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="48dp">

        <TextView
            android:id="@+id/readyDriverIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="◉"
            android:textColor="#DCC6AB"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="운전석"
            android:textColor="#F6F6F7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="탑승 확인"
            android:textColor="#99F6F6F7"
            android:textSize="21sp" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/readyVehicle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="20dp"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="48dp">

        <TextView
            android:id="@+id/readyVehicleIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="↗"
            android:textColor="#DCC6AB"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="차량 기능"
            android:textColor="#F6F6F7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="지원 확인"
            android:textColor="#99F6F6F7"
            android:textSize="21sp" />
      </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/readyNext"
        android:layout_width="600dp"
        android:layout_height="100dp"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="모드 선택하기"
        android:textColor="#1B1C20"
        android:textSize="32sp"
        android:textStyle="bold" />
  </LinearLayout>

  <!-- 3. 모드 선택 -->
  <LinearLayout
      android:id="@+id/modeSelectView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:paddingHorizontal="56dp"
      android:paddingTop="120dp"
      android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT MODE"
        android:textColor="#DCC6AB"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="지금 필요한 시간은 무엇인가요?"
        android:textColor="#F6F6F7"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="원하는 모드와 시간을 선택해 주세요."
        android:textColor="#99F6F6F7"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal">

      <LinearLayout
          android:id="@+id/relaxButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="48dp">

        <TextView
            android:id="@+id/relaxButtonIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="◎"
            android:textColor="#DCC6AB"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="릴렉스"
            android:textColor="#F6F6F7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="5분"
            android:textColor="#A9A2E8"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="호흡과 스트레칭으로 긴장을 풀어요."
            android:textColor="#99F6F6F7"
            android:textSize="21sp" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/napButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="20dp"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="48dp">

        <TextView
            android:id="@+id/napButtonIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="☾"
            android:textColor="#DCC6AB"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="냅핑"
            android:textColor="#F6F6F7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="20분"
            android:textColor="#A9A2E8"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="20분 동안 쉬고 천천히 깨어나요."
            android:textColor="#99F6F6F7"
            android:textSize="21sp" />
      </LinearLayout>

      <LinearLayout
          android:id="@+id/awakeButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="20dp"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="48dp">

        <TextView
            android:id="@+id/awakeButtonIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="✳"
            android:textColor="#DCC6AB"
            android:textSize="50sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="각성"
            android:textColor="#F6F6F7"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="3분"
            android:textColor="#A9A2E8"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="다음 일정 전에 집중을 준비해요."
            android:textColor="#99F6F6F7"
            android:textSize="21sp" />
      </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="모드를 선택하면 싱잉볼로 시작해요."
        android:textColor="#99F6F6F7"
        android:textSize="18sp" />
  </LinearLayout>

  <!-- 4. 모드 화면이 들어갈 자리 (mode_relax.xml / mode_nap.xml / mode_awake.xml) -->
  <FrameLayout
      android:id="@+id/modeContainer"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:visibility="gone" />

  <!-- 5. 안전 중단 (모드 중에 P에서 빠지면) -->
  <FrameLayout
      android:id="@+id/safetyView"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#1B1C20"
      android:visibility="gone">

    <LinearLayout
        android:id="@+id/safetyCard"
        android:layout_width="680dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="40dp">

      <TextView
          android:id="@+id/safetyIcon"
          android:layout_width="100dp"
          android:layout_height="72dp"
          android:gravity="center"
          android:text="!"
          android:textColor="#DCC6AB"
          android:textSize="36sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:text="차량 상태가 바뀌어 중단했어요"
          android:textColor="#F6F6F7"
          android:textSize="30sp"
          android:textStyle="bold" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="안전을 위해 모드를 종료했어요."
          android:textColor="#B3F6F6F7"
          android:textSize="20sp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="주차 상태를 확인한 뒤 다시 시작해 주세요."
          android:textColor="#80F6F6F7"
          android:textSize="17sp" />

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="36dp"
          android:orientation="horizontal">

        <TextView
            android:id="@+id/safetyClose"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="닫기"
            android:textColor="#1B1C20"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/safetyDetail"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="설정 상태 보기"
            android:textColor="#F6F6F7"
            android:textSize="22sp"
            android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>

  <!-- 6. 위쪽 바: ‹ 뒤로 · SAI 로고 · × 강제 종료 (모든 화면 위에 보여요) -->
  <LinearLayout
      android:id="@+id/headerBar"
      android:layout_width="match_parent"
      android:layout_height="112dp"
      android:layout_gravity="top"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingHorizontal="28dp">

    <TextView
        android:id="@+id/headerBack"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#F6F6F7"
        android:textSize="56sp" />

    <!-- SAI 로고 그림: res/drawable/sai_logo.png -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="SAI"
        android:src="@drawable/sai_logo" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/headerClose"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="#F6F6F7"
        android:textSize="40sp" />
  </LinearLayout>

  <!-- 7. 차량 설정 실패 메시지 (작은 글씨, 테스트용) -->
  <TextView
      android:id="@+id/debugText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|start"
      android:layout_margin="8dp"
      android:textColor="#66F6F6F7"
      android:textSize="11sp" />

</FrameLayout>
